# 复制为 deploy/.env 后修改。

FRONTEND_PORT=80
BACKEND_PORT=8000

# 国内服务器如拉 Docker Hub 超时，可改为国内镜像仓库地址。
# 示例：
# POSTGRES_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/postgres:16-alpine
# REDIS_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/redis:7-alpine
# PYTHON_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/python:3.12-slim
# NODE_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/node:22-alpine
# NGINX_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/nginx:1.27-alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-01-20T14-49-07Z
PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine

POSTGRES_DB=vocab_helper
POSTGRES_USER=vocab
POSTGRES_PASSWORD=change_me_strong_password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=vocab-helper

# 正式域名建议改为 https://your-domain.com
CORS_ALLOW_ORIGINS=*

# OpenAI-compatible 大模型接入示例：
# 通义千问兼容模式：https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：https://api.deepseek.com
# 火山方舟/豆包：填写平台提供的 OpenAI-compatible endpoint
AI_PROVIDER=openai_compatible
AI_API_BASE=
AI_API_KEY=
AI_MODEL=qwen-plus

# 答题照片 OCR 和发音 ASR。未配置时使用 mock 演示逻辑。
OCR_PROVIDER=mock
OCR_API_URL=
OCR_API_KEY=
ASR_PROVIDER=mock
ASR_API_URL=
ASR_API_KEY=
