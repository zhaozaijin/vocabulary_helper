# 复制为 deploy/.env 后修改。

# 默认仅本机可访问；完成鉴权后才考虑开放前端。
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=80
BACKEND_PORT=8000

POSTGRES_DB=vocab_helper
POSTGRES_USER=vocab
# 必填：分别使用 openssl rand -hex 24 生成两个不同的值。
POSTGRES_PASSWORD=

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=vocab-helper

# 正式域名建议改为 https://your-domain.com
CORS_ALLOW_ORIGINS=http://localhost

# OpenAI-compatible 大模型接入示例：
# 通义千问兼容模式：https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：https://api.deepseek.com
# 火山方舟/豆包：填写平台提供的 OpenAI-compatible endpoint
AI_PROVIDER=openai_compatible
AI_API_BASE=
AI_API_KEY=
AI_MODEL=qwen-plus

# 答题照片 OCR 和发音 ASR。未配置时使用 mock 演示逻辑。
# 阿里云 OCR：将 OCR_PROVIDER 改为 aliyun，并填写 ALIYUN_*。
# 阿里云一句话识别：将 ASR_PROVIDER 改为 aliyun_nls，并填写 ALIYUN_NLS_APP_KEY。
OCR_PROVIDER=mock
OCR_API_URL=
OCR_API_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
ASR_PROVIDER=mock
ASR_API_URL=
ASR_API_KEY=
ALIYUN_NLS_REGION=cn-shanghai
ALIYUN_NLS_ENDPOINT=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/asr
ALIYUN_NLS_SAMPLE_RATE=16000
ALIYUN_NLS_FORMAT=
ALIYUN_NLS_ENABLE_PUNCTUATION=false
ALIYUN_NLS_ENABLE_ITN=true
ALIYUN_NLS_ENABLE_VOICE_DETECTION=true
ALIYUN_NLS_APP_KEY=
