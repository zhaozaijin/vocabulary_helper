# 云端生产建议使用 PostgreSQL；本地不配置时会自动使用 SQLite 兜底。
DATABASE_URL=postgresql://vocab:vocab_password@postgres:5432/vocab_helper

# 前端域名，多个域名用英文逗号分隔。演示可保留 *。
CORS_ALLOW_ORIGINS=*

# OpenAI-compatible 大模型接入。可接 DeepSeek、通义千问、豆包、文心等兼容网关。
AI_PROVIDER=openai_compatible
AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=replace_with_your_api_key
AI_MODEL=qwen-plus

# OCR/ASR 可接学校已有网关或云厂商封装服务。未配置时使用演示 mock。
# 阿里云 OCR：将 OCR_PROVIDER 改为 aliyun，并填写 ALIYUN_*。
OCR_PROVIDER=mock
OCR_API_URL=
OCR_API_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
ASR_PROVIDER=mock
ASR_API_URL=
ASR_API_KEY=
